/** Pipeline comercial separado del WorkflowStage de CreditCase. */
model Opportunity {
  id              String           @id @default(cuid())
  organizationId  String
  clientId        String
  ownerId         String?
  stage           OpportunityStage @default(NEW_LEAD)
  estimatedValue  Decimal?         @db.Decimal(12, 2)
  source          String?
  campaign        String?
  lostReason      String?          @db.Text
  nextFollowUpAt  DateTime?
  wonCaseId       String?
  wonServiceCaseId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  owner        User?        @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  wonCase      CreditCase?  @relation(fields: [wonCaseId], references: [id], onDelete: SetNull)
  wonServiceCase ServiceCase? @relation("OpportunityWonServiceCase", fields: [wonServiceCaseId], references: [id], onDelete: SetNull)

  @@index([organizationId, stage, updatedAt])
  @@index([organizationId, ownerId])
  @@index([clientId, stage])
  @@index([organizationId, nextFollowUpAt])
  @@index([wonServiceCaseId])
}

/** Idempotencia de leads Meta (Facebook/Instagram Lead Ads). */
model MetaLeadEvent {
  id             String   @id @default(cuid())
  organizationId String
  externalLeadId String
  pageId         String?
  formId         String?
  adId           String?
  adsetId        String?
  campaignId     String?
  clientId       String?
  opportunityId  String?
  payloadJson    Json?
  processedAt    DateTime @default(now())
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, externalLeadId])
  @@index([organizationId, processedAt])
  @@index([clientId])
}

/** Reporte de crédito estructurado (metadata; el PDF sigue en Document). */
model CreditReport {
  id               String           @id @default(cuid())
  organizationId   String
  clientId         String
  caseId           String
  documentId       String?
  provider         String?
  externalReportId String?
  reportDate       DateTime         @db.Date
  importedAt       DateTime         @default(now())
  type             CreditReportType @default(MANUAL)
  notes            String?          @db.Text
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  case         CreditCase              @relation(fields: [caseId], references: [id], onDelete: Cascade)
  document     Document?               @relation(fields: [documentId], references: [id], onDelete: SetNull)
  snapshots    CreditBureauSnapshot[]
  items        CreditItem[]
  comparisonsAsBase    ReportComparison[] @relation("ComparisonBaseReport")
  comparisonsAsCompare ReportComparison[] @relation("ComparisonCompareReport")

  @@index([organizationId, caseId])
  @@index([organizationId, clientId])
  @@index([caseId, reportDate])
  @@index([organizationId, type])
  @@index([documentId])
}

/** Snapshot de scores y contadores por buró dentro de un CreditReport. */
model CreditBureauSnapshot {
  id                String       @id @default(cuid())
  reportId          String
  bureau            CreditBureau
  score             Int?
  totalAccounts     Int?
  openAccounts      Int?
  closedAccounts    Int?
  negativeAccounts  Int?
  collections       Int?
  inquiries         Int?
  totalBalance      Decimal?     @db.Decimal(12, 2)
  utilization       Decimal?     @db.Decimal(5, 2)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  report CreditReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, bureau])
  @@index([reportId])
}

/** Elemento/cuenta de un reporte de crédito (número solo enmascarado). */
model CreditItem {
  id                   String                     @id @default(cuid())
  organizationId       String
  clientId             String
  caseId               String
  reportId             String
  creditorName         String
  accountNumberMasked  String?
  accountType          String?
  bureau               CreditBureau
  balance              Decimal?                   @db.Decimal(12, 2)
  creditLimit          Decimal?                   @db.Decimal(12, 2)
  monthlyPayment       Decimal?                   @db.Decimal(12, 2)
  dateOpened           DateTime?                  @db.Date
  dateReported         DateTime?                  @db.Date
  accountStatus        String?
  paymentStatus        String?
  negativeType         CreditNegativeType?
  remarks              String?                    @db.Text
  isNegative           Boolean                    @default(false)
  disputeEligible      Boolean                    @default(true)
  lifecycleStatus      CreditItemLifecycleStatus  @default(IDENTIFIED)
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  case         CreditCase   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  report       CreditReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  disputeItems DisputeItem[]
  comparisonBaseItems    ReportComparisonItem[] @relation("ComparisonBaseItem")
  comparisonCompareItems ReportComparisonItem[] @relation("ComparisonCompareItem")

  @@index([organizationId, caseId])
  @@index([organizationId, clientId])
  @@index([reportId])
  @@index([caseId, isNegative])
  @@index([organizationId, lifecycleStatus])
  @@index([caseId, bureau])
}

/** Elemento incluido en una ronda de disputa. */
model DisputeItem {
  id              String            @id @default(cuid())
  organizationId  String
  roundId         String
  creditItemId    String
  bureau          CreditBureau
  disputeReason   String
  disputeDetails  String?           @db.Text
  status          DisputeItemStatus @default(SELECTED)
  outcome         DisputeOutcome?
  notes           String?           @db.Text
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  round        CreditRound  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  creditItem   CreditItem   @relation(fields: [creditItemId], references: [id], onDelete: Cascade)
  letterLinks  DisputeLetterItem[]

  @@unique([roundId, creditItemId])
  @@index([organizationId, roundId])
  @@index([creditItemId])
  @@index([roundId, status])
  @@index([roundId, outcome])
}

/** Comparación entre dos reportes de un caso. */
model ReportComparison {
  id              String   @id @default(cuid())
  organizationId  String
  caseId          String
  baseReportId    String
  compareReportId String
  createdById     String?
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization  Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  case          CreditCase            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  baseReport    CreditReport          @relation("ComparisonBaseReport", fields: [baseReportId], references: [id], onDelete: Cascade)
  compareReport CreditReport          @relation("ComparisonCompareReport", fields: [compareReportId], references: [id], onDelete: Cascade)
  createdBy     User?                 @relation("ComparisonCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items         ReportComparisonItem[]

  @@unique([baseReportId, compareReportId])
  @@index([organizationId, caseId])
  @@index([caseId, createdAt])
}

/** Resultado por cuenta dentro de una comparación (auto + override manual). */
model ReportComparisonItem {
  id                   String               @id @default(cuid())
  comparisonId         String
  baseItemId           String?
  compareItemId        String?
  autoResult           ComparisonResultKind
  manualResult         ComparisonResultKind?
  matchKey             String
  creditorName         String
  bureau               CreditBureau
  accountNumberMasked  String?
  notes                String?              @db.Text
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  comparison  ReportComparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  baseItem    CreditItem?      @relation("ComparisonBaseItem", fields: [baseItemId], references: [id], onDelete: SetNull)
  compareItem CreditItem?      @relation("ComparisonCompareItem", fields: [compareItemId], references: [id], onDelete: SetNull)

  @@index([comparisonId])
  @@index([comparisonId, autoResult])
  @@index([matchKey])
}

/** Plantilla de carta de disputa (variables {{client.fullName}}, etc.). */
model DisputeLetterTemplate {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  bureau         CreditBureau?
  subject        String
  content        String         @db.LongText
  version        Int            @default(1)
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  letters      DisputeLetter[]

  @@index([organizationId, active])
  @@index([organizationId, bureau])
}

/** Carta generada para una ronda (revisión humana obligatoria antes de FINAL/SENT). */
model DisputeLetter {
  id               String              @id @default(cuid())
  organizationId   String
  roundId          String
  bureau           CreditBureau
  templateId       String?
  recipient        String
  subjectSnapshot  String
  contentSnapshot  String              @db.LongText
  status           DisputeLetterStatus @default(DRAFT)
  generatedAt      DateTime            @default(now())
  finalizedAt      DateTime?
  sentAt           DateTime?
  trackingNumber   String?
  documentId       String?
  notes            String?             @db.Text
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  round        CreditRound           @relation(fields: [roundId], references: [id], onDelete: Cascade)
  template     DisputeLetterTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  document     Document?             @relation(fields: [documentId], references: [id], onDelete: SetNull)
  items        DisputeLetterItem[]

  @@index([organizationId, roundId])
  @@index([roundId, bureau])
  @@index([roundId, status])
  @@index([documentId])
}

model DisputeLetterItem {
  id            String @id @default(cuid())
  letterId      String
  disputeItemId String

  letter      DisputeLetter @relation(fields: [letterId], references: [id], onDelete: Cascade)
  disputeItem DisputeItem   @relation(fields: [disputeItemId], references: [id], onDelete: Cascade)

  @@unique([letterId, disputeItemId])
  @@index([disputeItemId])
}

/** Snapshot de reporte visual al cliente (HTML en CRM; PDF solo on-demand). */
model ClientProgressReport {
  id             String    @id @default(cuid())
  organizationId String
  caseId         String
  roundId        String?
  createdById    String?
  clientName     String
  caseCode       String
  periodLabel    String
  roundLabel     String
  reportDate     DateTime  @default(now())
  scoresJson     Json
  resultsJson    Json
  resultLinesJson Json
  nextSteps      String    @db.Text
  nextReviewAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  case         CreditCase   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  round        CreditRound? @relation(fields: [roundId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation("ProgressReportCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, caseId, createdAt])
  @@index([roundId, createdAt])
}

model AiChat {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  title          String   @db.VarChar(120)
  messages       Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, updatedAt])
}

/** Contadores de rate limit para APIs públicas (intake, contacto). */
model RateLimitBucket {
  id          String   @id @default(cuid())
  bucketKey   String   @db.VarChar(191)
  windowStart DateTime
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([bucketKey, windowStart])
  @@index([windowStart])
}

model MailMessage {
  id                 String        @id @default(cuid())
  organizationId     String
  folder             MailFolder    @default(INBOX)
  direction          MailDirection
  fromAddress        String
  fromName           String?
  toAddresses        Json
  ccAddresses        Json?
  subject            String        @db.VarChar(500)
  bodyText           String        @db.Text
  bodyHtml           String?       @db.LongText
  translationEsSubject String?     @db.VarChar(500)
  translationEsBody    String?     @db.Text
  translatedAt         DateTime?
  isRead             Boolean       @default(false)
  internetMessageId  String?       @db.VarChar(255)
  inReplyToId        String?
  clientId           String?
  createdById        String?
  sentAt             DateTime?
  receivedAt         DateTime?
  archivedAt         DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation("MailCreator", fields: [createdById], references: [id], onDelete: SetNull)
  inReplyTo    MailMessage? @relation("MailThread", fields: [inReplyToId], references: [id], onDelete: SetNull)
  replies      MailMessage[] @relation("MailThread")

  @@unique([organizationId, internetMessageId])
  @@index([organizationId, folder, createdAt])
  @@index([organizationId, isRead, folder])
  @@index([clientId])
  @@index([createdById])
  @@index([inReplyToId])
}

/** BR-080: consentimiento, aprobación y publicación son decisiones separadas. */
enum TestimonialStatus {
  PENDING
  APPROVED
  REJECTED
}

model Testimonial {
  id                  String @id @default(cuid())
  organizationId      String
  clientId            String
  serviceCaseId       String?
  displayName         String @db.VarChar(120)
  body                String @db.Text
  rating              Int?
  status              TestimonialStatus @default(PENDING)
  consentGrantedAt    DateTime?
  consentRevokedAt    DateTime?
  consentSignerName   String? @db.VarChar(120)
  consentEvidence     String? @db.Text
  consentVersion      String?
  consentText         String? @db.Text
  consentContentHash  String?
  consentRecordedById String?
  reviewedAt          DateTime?
  reviewedById        String?
  publishedAt         DateTime?
  deletedAt           DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  serviceCase ServiceCase? @relation(fields: [serviceCaseId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, publishedAt])
  @@index([clientId, createdAt])
  @@index([serviceCaseId])
}
