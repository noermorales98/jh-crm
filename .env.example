# Copia a .env.local y rellena los valores. No subas secretos al repo.

DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE?sslaccept=strict&connection_limit=1&connect_timeout=10&pool_timeout=10"
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

CRON_SECRET=""
# Bearer para cron-job.org: /api/cron/reminders, /api/cron/digest,
# /api/cron/mails-sync y /api/cron/retention
FIELD_ENCRYPTION_KEY=""

BOOTSTRAP_OWNER_EMAIL=""
BOOTSTRAP_OWNER_PASSWORD=""
BOOTSTRAP_OWNER_NAME=""

# OpenRouter — chat de IA del CRM (modelos gratuitos)
# Clave en https://openrouter.ai/keys
OPENROUTER_API_KEY=""
OPENROUTER_API_KEY_SECONDARY=""
# Opcional. Por defecto: openrouter/free
# OPENROUTER_MODEL="openrouter/free"

FEATURE_PUBLIC_INTAKE="false"
# Si true: /intake/[token] + generar enlace en ficha de cliente.
# Rate limit de APIs públicas usa MySQL (tabla RateLimitBucket).

FEATURE_CONSULTATION_PAYMENTS="false"
# Si true Y hay pasarela configurada: permite estado PAYMENT_PENDING/PAID en consultas.
# Sin pasarela real nunca se marca PAID automáticamente.

FEATURE_CLIENT_PORTAL="false"
# Si true: /portal/* + invitación desde ficha de cliente (portal.manage).

S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"
UPLOAD_MAX_MB="15"
