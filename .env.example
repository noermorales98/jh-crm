# Copia a .env.local y rellena los valores. No subas secretos al repo.
#
# QA / sandbox (JH-001): usa DB descartable. Para builds de verificación:
#   export QA_SANDBOX=1
#   npm run ci:qa          # lint + tsc + TEST-007 + build SIN migrate
# Ver docs/QA_SANDBOX.md. Nunca apuntes DATABASE_URL a producción en QA.

DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE?sslaccept=strict&connection_limit=1&connect_timeout=10&pool_timeout=10"
# QA_SANDBOX="1"
# RUN_PRISMA_MIGRATE / ALLOW_QA_MIGRATE: solo overrides explícitos de migrate-on-deploy.mjs
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# JH-005: TTL JWT en segundos (default 30 días = 2592000). Revocación = sessionVersion/isActive.
# SESSION_MAX_AGE_SECONDS="2592000"
# Org activa preferida si el usuario tiene varias membresías:
# AUTH_DEFAULT_ORGANIZATION_ID=""
# Si true y hay >1 org sin default, no elige org (login sin tenant):
# AUTH_ORG_STRICT="false"

CRON_SECRET=""
# Bearer para cron-job.org: /api/cron/reminders, /api/cron/digest,
# /api/cron/mails-sync, /api/cron/retention y /api/cron/credit-pdf-import
FIELD_ENCRYPTION_KEY=""

BOOTSTRAP_OWNER_EMAIL=""
BOOTSTRAP_OWNER_PASSWORD=""
BOOTSTRAP_OWNER_NAME=""

# OpenRouter — solo modelos gratuitos (:free o openrouter/free). Sin de pago.
# Clave en https://openrouter.ai/keys
OPENROUTER_API_KEY=""
OPENROUTER_API_KEY_SECONDARY=""
# Chat CRM. Opcional. Por defecto: openrouter/free
# OPENROUTER_MODEL="openrouter/free"
# Análisis PDF de crédito. Opcional. Debe terminar en :free (o openrouter/free).
# Default en código: google/gemma-4-26b-a4b-it:free
# Alternativa free: minimax/minimax-m3.1-flash:free
# CREDIT_PDF_OPENROUTER_MODEL="google/gemma-4-26b-a4b-it:free"

FEATURE_PUBLIC_INTAKE="false"
# Si true: /intake/[token] + generar enlace en ficha de cliente.
# Rate limit de APIs públicas usa MySQL (tabla RateLimitBucket).

# Organización que recibe POST /api/public/contact (cuid de Organization).
# Obligatoria para captación web. Sin ella el formulario no escribe.
# No uses “la org más antigua”: pon el id explícito del tenant operado.
PUBLIC_ORG_ID=""


FEATURE_CONSULTATION_PAYMENTS="false"
# Opt-out de emergencia: solo el valor "false" bloquea cobros de consulta.
# Ausente o cualquier otro valor: no bloquea por este flag (manda la pasarela/org).
# Sin pasarela real no se marca PAID automáticamente.

FEATURE_CLIENT_PORTAL="false"
# Si true: /portal/* + invitación desde ficha de cliente (portal.manage).

S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"
UPLOAD_MAX_MB="15"

# AU-006 — APIs automáticas de buró (fail-closed).
# Sin proveedor de pago + compliance deja "none" (default) y usa CR-PDF-001.
# BUREAU_PROVIDER="none"
# Cuando haya adaptador real (ej. agregador contratado): BUREAU_PROVIDER="<id>"
