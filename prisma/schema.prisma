generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  SPECIALIST
  STAFF
  VIEWER
}

enum ClientStatus {
  LEAD
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum CaseState {
  OPEN
  PAUSED
  COMPLETED
  CANCELLED
}

enum RoundStatus {
  DRAFT
  PREPARING
  SENT
  WAITING_UPDATE
  REVIEWING
  COMPLETED
  CANCELLED
}

enum DocumentCategory {
  IDENTITY
  PROOF_OF_ADDRESS
  SSN_DOCUMENT
  CREDIT_REPORT
  DISPUTE_LETTER
  UPDATE_REPORT
  PAYMENT_PROOF
  OTHER
}

enum DocumentSensitivity {
  INTERNAL
  CONFIDENTIAL
  HIGHLY_SENSITIVE
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskType {
  FOLLOW_UP
  REQUEST_DOCUMENT
  REQUEST_PAYMENT
  CREDIT_UPDATE
  PREPARE_ROUND
  CALL
  MESSAGE
  REVIEW_RESULT
  OTHER
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ActivityType {
  CREATED
  NOTE
  STATUS_CHANGE
  STAGE_CHANGE
  DOCUMENT_UPLOAD
  DOCUMENT_DELETE
  ROUND_CREATED
  ROUND_SENT
  ROUND_REVIEWED
  TASK_CREATED
  TASK_COMPLETED
  QUOTE_CREATED
  QUOTE_SENT
  PAYMENT_RECORDED
  RECEIPT_CREATED
  MAIL_SENT
  MAIL_RECEIVED
  OTHER
}

enum MailFolder {
  INBOX
  SENT
  DRAFTS
  ARCHIVE
  SPAM
  TRASH
}

enum MailDirection {
  INBOUND
  OUTBOUND
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  PARTIAL
  PAID
  CANCELLED
}

enum QuoteEventType {
  CREATED
  EDITED
  SENT
  ACCEPTED
  REJECTED
  PAYMENT_RECORDED
  PARTIALLY_PAID
  PAID
  EXPIRED
  CANCELLED
  NOTE
}

enum PaymentStatus {
  PENDING
  RECEIVED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  ZELLE
  STRIPE
  CASH
  BANK_TRANSFER
  OTHER
}

enum ReceiptStatus {
  ISSUED
  VOID
}

enum NotificationType {
  TASK_DUE
  TASK_OVERDUE
  CASE_REVIEW_DUE
  ROUND_REVIEW_DUE
  PAYMENT_DUE
  SYSTEM
  DAILY_DIGEST
  MAIL_RECEIVED
  CONTACT_FORM
  INTAKE_SUBMITTED
}

model User {
  id             String   @id @default(cuid())
  name           String?
  email          String   @unique
  passwordHash   String
  isActive       Boolean  @default(true)
  sessionVersion Int      @default(1)
  lastLoginAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberships      OrganizationMember[]
  assignedClients  Client[]        @relation("ClientAssignee")
  assignedCases    CreditCase[]    @relation("CaseAssignee")
  assignedTasks    Task[]          @relation("TaskAssignee")
  createdTasks     Task[]          @relation("TaskCreator")
  uploadedDocs     Document[]      @relation("DocumentUploader")
  createdQuotes    Quote[]         @relation("QuoteCreator")
  createdPayments  Payment[]       @relation("PaymentCreator")
  activities       ActivityLog[]   @relation("ActivityActor")
  auditLogs        AuditLog[]      @relation("AuditActor")
  notifications    Notification[]
  intakeLinks      IntakeLink[]    @relation("IntakeLinkCreator")
  aiChats          AiChat[]
  createdMails     MailMessage[] @relation("MailCreator")
}

model Organization {
  id        String   @id @default(cuid())
  name      String   @default("J&H Multiservices LLC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings           OrganizationSettings?
  members            OrganizationMember[]
  stages             WorkflowStage[]
  clients            Client[]
  sensitiveProfiles  ClientSensitiveProfile[]
  cases              CreditCase[]
  rounds             CreditRound[]
  documents          Document[]
  tasks              Task[]
  activities         ActivityLog[]
  services           Service[]
  packages           ServicePackage[]
  quotes             Quote[]
  quoteEvents        QuoteEvent[]
  payments           Payment[]
  receipts           Receipt[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  aiChats            AiChat[]
  intakeLinks        IntakeLink[]
  intakeSubmissions  IntakeSubmission[]
  consents           ConsentRecord[]
  externalReferences ExternalReference[]
  whatsappRecipients WhatsappRecipient[]
  emailRecipients    EmailNotificationRecipient[]
  mailMessages       MailMessage[]
}

model OrganizationSettings {
  id             String   @id @default(cuid())
  organizationId String   @unique
  legalName      String   @default("J&H Multiservices LLC")
  logoUrl        String?
  phone          String?
  email          String?
  website        String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  postalCode     String?
  country        String   @default("US")
  timezone       String   @default("America/Chicago")
  currency       String   @default("USD")
  defaultTaxRate Decimal  @default(0) @db.Decimal(5, 2)
  quotePrefix    String   @default("Q")
  receiptPrefix  String   @default("REC")
  clientPrefix   String   @default("CL")
  casePrefix     String   @default("CASE")
  quoteCounter   Int      @default(0)
  receiptCounter Int      @default(0)
  clientCounter  Int      @default(0)
  caseCounter    Int      @default(0)
  defaultTerms   String?  @db.Text
  callmebotEnabled Boolean @default(false)
  smtpHost                 String?
  smtpPort                 Int?
  smtpUser                 String?
  smtpPasswordEncrypted    String?  @db.Text
  smtpFrom                 String?
  smtpSecure               Boolean  @default(true)
  smtpTestTo               String?
  digestEnabled            Boolean  @default(true)
  digestHour               Int      @default(8)
  notifyEmailTask          Boolean  @default(true)
  notifyWhatsappTask       Boolean  @default(true)
  notifyEmailCase          Boolean  @default(true)
  notifyWhatsappCase       Boolean  @default(true)
  notifyEmailPayment       Boolean  @default(true)
  notifyWhatsappPayment    Boolean  @default(true)
  notifyEmailDigest        Boolean  @default(true)
  notifyWhatsappDigest     Boolean  @default(true)
  notifyEmailMail          Boolean  @default(true)
  notifyWhatsappMail       Boolean  @default(true)
  notifyEmailContact       Boolean  @default(true)
  notifyWhatsappContact    Boolean  @default(true)
  notifyEmailIntake        Boolean  @default(true)
  notifyWhatsappIntake     Boolean  @default(true)
  emailClientPaymentDue    Boolean  @default(false)
  emailClientDocsPending   Boolean  @default(false)
  emailClientQuoteSent     Boolean  @default(false)
  emailClientQuoteExpiring Boolean  @default(false)
  emailClientCaseReview    Boolean  @default(false)
  emailClientRoundReview   Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model WhatsappRecipient {
  id              String   @id @default(cuid())
  organizationId  String
  label           String
  phone           String
  apiKeyEncrypted String   @db.Text
  enabled         Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, phone])
  @@index([organizationId, enabled])
}

/** Destinatarios de correo de avisos (p. ej. intake); no tienen que ser usuarios del CRM. */
model EmailNotificationRecipient {
  id             String   @id @default(cuid())
  organizationId String
  label          String
  email          String
  enabled        Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([organizationId, enabled])
}

model OrganizationMember {
  id             String   @id @default(cuid())
  role           Role     @default(STAFF)
  userId         String
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, role])
}

model WorkflowStage {
  id             String   @id @default(cuid())
  organizationId String
  key            String
  name           String
  order          Int
  color          String   @default("#64748B")
  isTerminal     Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cases        CreditCase[]

  @@unique([organizationId, key])
  @@unique([organizationId, order])
  @@index([organizationId, isActive])
}

model Client {
  id             String       @id @default(cuid())
  organizationId String
  clientCode     String
  firstName      String
  lastName       String?
  email          String?
  phone          String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  postalCode     String?
  country        String       @default("US")
  source         String?
  status         ClientStatus @default(LEAD)
  assignedToId   String?
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo      User?                   @relation("ClientAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  sensitive       ClientSensitiveProfile?
  cases           CreditCase[]
  documents       Document[]
  tasks           Task[]
  activities      ActivityLog[]
  quotes          Quote[]
  payments        Payment[]
  receipts        Receipt[]
  intakeLinks     IntakeLink[]
  intakeSubmits   IntakeSubmission[]
  consents        ConsentRecord[]
  externalRefs    ExternalReference[]
  mailMessages    MailMessage[]

  @@unique([organizationId, clientCode])
  @@index([organizationId, status])
  @@index([organizationId, assignedToId])
  @@index([organizationId, lastName, firstName])
  @@index([organizationId, createdAt])
  @@index([organizationId, email])
  @@index([organizationId, phone])
}

model ClientSensitiveProfile {
  id                           String   @id @default(cuid())
  organizationId               String
  clientId                     String   @unique
  ssnLast4                     String?  @db.VarChar(4)
  ssnEncrypted                 String?  @db.Text
  dateOfBirthEncrypted         String?  @db.Text
  driversLicenseNumberEncrypted String? @db.Text
  sensitiveNotesEncrypted      String?  @db.Text
  encryptionVersion            Int      @default(1)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model CreditCase {
  id             String    @id @default(cuid())
  organizationId String
  clientId       String
  caseCode       String
  stageId        String
  state          CaseState @default(OPEN)
  assignedToId   String?
  openedAt       DateTime  @default(now())
  nextReviewAt   DateTime?
  closedAt       DateTime?
  summary        String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  stage        WorkflowStage @relation(fields: [stageId], references: [id], onDelete: Restrict)
  assignedTo   User?         @relation("CaseAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  rounds        CreditRound[]
  documents     Document[]
  tasks         Task[]
  activities    ActivityLog[]
  quotes        Quote[]
  payments      Payment[]
  intakeLinks   IntakeLink[]
  intakeSubmits IntakeSubmission[]
  consents      ConsentRecord[]
  externalRefs  ExternalReference[]

  @@unique([organizationId, caseCode])
  @@index([organizationId, stageId])
  @@index([organizationId, state, nextReviewAt])
  @@index([clientId, state])
  @@index([assignedToId, state])
}

model CreditRound {
  id                    String      @id @default(cuid())
  organizationId        String
  caseId                String
  roundNumber           Int
  status                RoundStatus @default(DRAFT)
  startedAt             DateTime    @default(now())
  sentAt                DateTime?
  expectedReviewAt      DateTime?
  reviewedAt            DateTime?
  lettersCount          Int         @default(0)
  disputedItemsCount    Int         @default(0)
  notes                 String?     @db.Text
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  case         CreditCase   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  documents    Document[]
  tasks        Task[]
  activities   ActivityLog[]

  @@unique([caseId, roundNumber])
  @@index([organizationId, status, expectedReviewAt])
  @@index([caseId, status])
}

model Document {
  id             String              @id @default(cuid())
  organizationId String
  clientId       String
  caseId         String?
  roundId        String?
  paymentId      String?
  category       DocumentCategory
  sensitivity    DocumentSensitivity @default(CONFIDENTIAL)
  originalName   String
  displayName    String?
  mimeType       String
  sizeBytes      Int
  storageKey     String              @unique
  checksumSha256 String?
  uploadedById   String?
  deletedAt      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  case         CreditCase?  @relation(fields: [caseId], references: [id], onDelete: SetNull)
  round        CreditRound? @relation(fields: [roundId], references: [id], onDelete: SetNull)
  payment      Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  uploadedBy   User?        @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([organizationId, clientId, category])
  @@index([caseId, category])
  @@index([roundId, category])
  @@index([paymentId])
  @@index([organizationId, deletedAt])
}

model Task {
  id             String       @id @default(cuid())
  organizationId String
  clientId       String?
  caseId         String?
  roundId        String?
  title          String
  description    String?      @db.Text
  type           TaskType     @default(OTHER)
  priority       TaskPriority @default(NORMAL)
  status         TaskStatus   @default(PENDING)
  dueAt          DateTime?
  reminderAt     DateTime?
  completedAt    DateTime?
  assignedToId   String
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  case         CreditCase?  @relation(fields: [caseId], references: [id], onDelete: SetNull)
  round        CreditRound? @relation(fields: [roundId], references: [id], onDelete: SetNull)
  assignedTo   User         @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, status, dueAt])
  @@index([assignedToId, status, dueAt])
  @@index([clientId, status])
  @@index([caseId, status])
  @@index([roundId, status])
  @@index([organizationId, reminderAt])
}

model Service {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?  @db.Text
  defaultPrice   Decimal  @default(0) @db.Decimal(12, 2)
  currency       String   @default("USD")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  packageItems ServicePackageItem[]
  quoteItems   QuoteItem[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
}

model ServicePackage {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?  @db.Text
  defaultPrice   Decimal  @default(0) @db.Decimal(12, 2)
  currency       String   @default("USD")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        ServicePackageItem[]
  quoteItems   QuoteItem[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
}

model ServicePackageItem {
  id        String @id @default(cuid())
  packageId String
  serviceId String
  quantity  Int    @default(1)

  package ServicePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  service Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([packageId, serviceId])
  @@index([serviceId])
}

model Quote {
  id             String      @id @default(cuid())
  organizationId String
  clientId       String
  caseId         String?
  folioNumber    Int
  folio          String
  status         QuoteStatus @default(DRAFT)
  currency       String      @default("USD")
  issuedAt       DateTime    @default(now())
  validUntil     DateTime?
  subtotal       Decimal     @default(0) @db.Decimal(12, 2)
  discountTotal  Decimal     @default(0) @db.Decimal(12, 2)
  taxRate        Decimal     @default(0) @db.Decimal(5, 2)
  taxAmount      Decimal     @default(0) @db.Decimal(12, 2)
  total          Decimal     @default(0) @db.Decimal(12, 2)
  notes          String?     @db.Text
  terms          String?     @db.Text
  sentAt         DateTime?
  acceptedAt     DateTime?
  paidAt         DateTime?
  createdById    String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  case         CreditCase?  @relation(fields: [caseId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation("QuoteCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items        QuoteItem[]
  events       QuoteEvent[]
  payments     Payment[]

  @@unique([organizationId, folio])
  @@index([organizationId, status, issuedAt])
  @@index([clientId, issuedAt])
  @@index([caseId, status])
}

model QuoteItem {
  id             String   @id @default(cuid())
  quoteId        String
  serviceId      String?
  packageId      String?
  description    String   @db.Text
  quantity       Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice      Decimal  @default(0) @db.Decimal(12, 2)
  discountAmount Decimal  @default(0) @db.Decimal(12, 2)
  total          Decimal  @default(0) @db.Decimal(12, 2)
  order          Int      @default(0)

  quote   Quote           @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  service Service?        @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  package ServicePackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  @@index([quoteId, order])
  @@index([serviceId])
  @@index([packageId])
}

model QuoteEvent {
  id             String         @id @default(cuid())
  organizationId String
  quoteId        String
  type           QuoteEventType
  description    String?        @db.Text
  metadata       Json?
  createdAt      DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quote        Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, createdAt])
  @@index([organizationId, createdAt])
}

model Payment {
  id             String        @id @default(cuid())
  organizationId String
  clientId       String
  caseId         String?
  quoteId        String?
  amount         Decimal       @db.Decimal(12, 2)
  currency       String        @default("USD")
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  reference      String?
  dueAt          DateTime?
  receivedAt     DateTime?
  notes          String?       @db.Text
  createdById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  case         CreditCase?  @relation(fields: [caseId], references: [id], onDelete: SetNull)
  quote        Quote?       @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation("PaymentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  documents    Document[]
  receipt      Receipt?

  @@index([organizationId, status, dueAt])
  @@index([clientId, receivedAt])
  @@index([quoteId, status])
  @@index([caseId, status])
}

model Receipt {
  id             String        @id @default(cuid())
  organizationId String
  paymentId      String        @unique
  clientId       String
  folioNumber    Int
  folio          String
  status         ReceiptStatus @default(ISSUED)
  amount         Decimal       @db.Decimal(12, 2)
  currency       String        @default("USD")
  paymentMethod  PaymentMethod
  issuedAt       DateTime      @default(now())
  voidedAt       DateTime?
  voidReason     String?       @db.Text
  notes          String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payment      Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([organizationId, folio])
  @@index([organizationId, status, issuedAt])
  @@index([clientId, issuedAt])
}

model ActivityLog {
  id             String       @id @default(cuid())
  organizationId String
  clientId       String
  caseId         String?
  roundId        String?
  actorUserId    String?
  type           ActivityType
  description    String       @db.Text
  metadata       Json?
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  case         CreditCase?  @relation(fields: [caseId], references: [id], onDelete: SetNull)
  round        CreditRound? @relation(fields: [roundId], references: [id], onDelete: SetNull)
  actor        User?        @relation("ActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
  @@index([caseId, createdAt])
  @@index([organizationId, createdAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorUserId    String?
  action         String
  entityType     String
  entityId       String?
  ipAddress      String?
  userAgent      String?  @db.Text
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
}

model Notification {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  type           NotificationType
  title          String
  body           String?          @db.Text
  link           String?
  dedupeKey      String?          @unique
  isRead         Boolean          @default(false)
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([organizationId, createdAt])
}

model IntakeLink {
  id             String   @id @default(cuid())
  organizationId String
  token          String   @unique
  clientId       String?
  caseId         String?
  createdById    String?
  expiresAt      DateTime?
  maxUses        Int      @default(1)
  useCount       Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  case         CreditCase?       @relation(fields: [caseId], references: [id], onDelete: SetNull)
  createdBy    User?             @relation("IntakeLinkCreator", fields: [createdById], references: [id], onDelete: SetNull)
  submissions  IntakeSubmission[]

  @@index([organizationId, isActive, expiresAt])
  @@index([clientId])
  @@index([caseId])
}

model IntakeSubmission {
  id             String   @id @default(cuid())
  organizationId String
  intakeLinkId   String
  clientId       String
  caseId         String?
  ipAddress      String?
  userAgent      String?  @db.Text
  submittedAt    DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  intakeLink   IntakeLink   @relation(fields: [intakeLinkId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  case         CreditCase?  @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@index([organizationId, submittedAt])
  @@index([intakeLinkId, submittedAt])
  @@index([clientId, submittedAt])
}

model ConsentRecord {
  id             String   @id @default(cuid())
  organizationId String
  clientId       String
  caseId         String?
  consentType    String
  version        String
  textHash       String
  signerName     String?
  ipAddress      String?
  userAgent      String?  @db.Text
  acceptedAt     DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  case         CreditCase?  @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@index([organizationId, consentType, acceptedAt])
  @@index([clientId, consentType])
  @@index([caseId, consentType])
}

model ExternalReference {
  id               String   @id @default(cuid())
  organizationId   String
  clientId         String
  caseId           String?
  provider         String
  label            String?
  url              String?  @db.Text
  externalMemberId String?
  notes            String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  case         CreditCase?  @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@index([organizationId, provider])
  @@index([clientId, provider])
  @@index([caseId, provider])
}

model AiChat {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  title          String   @db.VarChar(120)
  messages       Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, updatedAt])
}

/** Contadores de rate limit para APIs públicas (intake, contacto). */
model RateLimitBucket {
  id          String   @id @default(cuid())
  bucketKey   String   @db.VarChar(191)
  windowStart DateTime
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([bucketKey, windowStart])
  @@index([windowStart])
}

model MailMessage {
  id                 String        @id @default(cuid())
  organizationId     String
  folder             MailFolder    @default(INBOX)
  direction          MailDirection
  fromAddress        String
  fromName           String?
  toAddresses        Json
  ccAddresses        Json?
  subject            String        @db.VarChar(500)
  bodyText           String        @db.Text
  bodyHtml           String?       @db.LongText
  translationEsSubject String?     @db.VarChar(500)
  translationEsBody    String?     @db.Text
  translatedAt         DateTime?
  isRead             Boolean       @default(false)
  internetMessageId  String?       @db.VarChar(255)
  inReplyToId        String?
  clientId           String?
  createdById        String?
  sentAt             DateTime?
  receivedAt         DateTime?
  archivedAt         DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation("MailCreator", fields: [createdById], references: [id], onDelete: SetNull)
  inReplyTo    MailMessage? @relation("MailThread", fields: [inReplyToId], references: [id], onDelete: SetNull)
  replies      MailMessage[] @relation("MailThread")

  @@unique([organizationId, internetMessageId])
  @@index([organizationId, folder, createdAt])
  @@index([organizationId, isRead, folder])
  @@index([clientId])
  @@index([createdById])
  @@index([inReplyToId])
}
