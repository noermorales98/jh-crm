generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  SPECIALIST
  STAFF
  VIEWER
}

enum ClientStatus {
  LEAD
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum CaseState {
  OPEN
  PAUSED
  COMPLETED
  CANCELLED
}

/** Estado operativo del expediente genérico (ServiceCase). Distinto de CaseState. */
enum ServiceCaseStatus {
  OPEN
  ON_HOLD
  COMPLETED
  CANCELED
}

enum RoundStatus {
  DRAFT
  PREPARING
  SENT
  WAITING_UPDATE
  REVIEWING
  COMPLETED
  CANCELLED
}

enum DocumentCategory {
  IDENTITY
  PROOF_OF_ADDRESS
  SSN_DOCUMENT
  CREDIT_REPORT
  DISPUTE_LETTER
  UPDATE_REPORT
  PAYMENT_PROOF
  OTHER
}

enum DocumentSensitivity {
  INTERNAL
  CONFIDENTIAL
  HIGHLY_SENSITIVE
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskType {
  FOLLOW_UP
  REQUEST_DOCUMENT
  REQUEST_PAYMENT
  CREDIT_UPDATE
  PREPARE_ROUND
  CALL
  MESSAGE
  REVIEW_RESULT
  OTHER
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ActivityType {
  CREATED
  NOTE
  STATUS_CHANGE
  STAGE_CHANGE
  DOCUMENT_UPLOAD
  DOCUMENT_DELETE
  ROUND_CREATED
  ROUND_SENT
  ROUND_REVIEWED
  TASK_CREATED
  TASK_COMPLETED
  QUOTE_CREATED
  QUOTE_SENT
  PAYMENT_RECORDED
  RECEIPT_CREATED
  MAIL_SENT
  MAIL_RECEIVED
  CREDIT_REPORT_CREATED
  CREDIT_REPORT_UPDATED
  DISPUTE_ITEM_ADDED
  DISPUTE_ITEM_UPDATED
  COMPARISON_CREATED
  COMPARISON_UPDATED
  LETTER_CREATED
  LETTER_UPDATED
  LETTER_FINALIZED
  PROGRESS_REPORT_GENERATED
  OPPORTUNITY_CREATED
  OPPORTUNITY_STAGE_CHANGED
  OPPORTUNITY_WON
  PROCESSOR_LINKED
  PAYMENT_PLAN_CREATED
  CONSULTATION_REQUESTED
  PORTAL_ACCESS_INVITED
  PORTAL_ACCESS_REVOKED
  CONTRACT_CREATED
  CONTRACT_SIGNED
  DOCUMENT_HARD_DELETED
  OTHER
}

enum CreditReportType {
  INITIAL
  UPDATE
  MANUAL
}

enum CreditBureau {
  EXPERIAN
  EQUIFAX
  TRANSUNION
}

enum LeadChannel {
  FACEBOOK
  INSTAGRAM
  GOOGLE
  WEBSITE
  REFERRAL
  MANUAL
  OTHER
}

enum OpportunityStage {
  NEW_LEAD
  CONTACTED
  CONSULTATION
  INTAKE_SENT
  INTAKE_COMPLETED
  PROPOSAL
  WAITING_PAYMENT
  WON
  LOST
}

enum ProcessorAccountStatus {
  PLANNED
  ACTIVE
  EXPIRED
  CANCELLED
}

enum CreditNegativeType {
  COLLECTION
  CHARGE_OFF
  LATE_PAYMENT
  REPOSSESSION
  BANKRUPTCY
  HARD_INQUIRY
  FORECLOSURE
  OTHER
}

enum CreditItemLifecycleStatus {
  IDENTIFIED
  UNDER_REVIEW
  SELECTED
  DISPUTED
  RESOLVED
  EXCLUDED
}

enum DisputeItemStatus {
  DRAFT
  SELECTED
  LETTER_GENERATED
  SENT
  WAITING
  RESPONDED
  COMPLETED
  CANCELLED
}

enum DisputeOutcome {
  DELETED
  UPDATED
  VERIFIED
  NO_CHANGE
  NOT_RESPONDED
  NEW_INFORMATION
  OTHER
}

enum ComparisonResultKind {
  DELETED
  UPDATED
  VERIFIED
  UNCHANGED
  NEW
}

enum DisputeLetterStatus {
  DRAFT
  READY_FOR_REVIEW
  FINAL
  SENT
  CANCELLED
}

enum MailFolder {
  INBOX
  SENT
  DRAFTS
  ARCHIVE
  SPAM
  TRASH
}

enum MailDirection {
  INBOUND
  OUTBOUND
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  PARTIAL
  PAID
  CANCELLED
}

enum QuoteEventType {
  CREATED
  EDITED
  SENT
  ACCEPTED
  REJECTED
  PAYMENT_RECORDED
  PARTIALLY_PAID
  PAID
  EXPIRED
  CANCELLED
  NOTE
}

enum PaymentStatus {
  PENDING
  RECEIVED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  ZELLE
  STRIPE
  CASH
  BANK_TRANSFER
  OTHER
}

enum ReceiptStatus {
  ISSUED
  VOID
}

enum PaymentPlanFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  CUSTOM
}

enum PaymentPlanStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  PAUSED
}

enum PaymentInstallmentStatus {
  PENDING
  PAID
  CANCELLED
  OVERDUE
}

enum ConsultationStatus {
  REQUESTED
  PAYMENT_PENDING
  PAID
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum ContractStatus {
  DRAFT
  SENT
  SIGNED
  CANCELLED
  EXPIRED
}

enum NotificationType {
  TASK_DUE
  TASK_OVERDUE
  CASE_REVIEW_DUE
  ROUND_REVIEW_DUE
  PAYMENT_DUE
  SYSTEM
  DAILY_DIGEST
  MAIL_RECEIVED
  CONTACT_FORM
  INTAKE_SUBMITTED
  CONSULTATION_REQUESTED
  PORTAL_MESSAGE
  CONTRACT_READY
  META_LEAD
}

model User {
  id             String   @id @default(cuid())
  name           String?
  email          String   @unique
  passwordHash   String
  isActive       Boolean  @default(true)
  sessionVersion Int      @default(1)
  lastLoginAt    DateTime?
  /** MFA/TOTP (OWNER/ADMIN/SPECIALIST). Secret y recovery codes cifrados. */
  mfaEnabled                 Boolean   @default(false)
  mfaSecretEncrypted         String?   @db.Text
  mfaRecoveryCodesEncrypted  String?   @db.Text
  mfaVerifiedAt              DateTime?
  mfaFailedAttempts          Int       @default(0)
  mfaLockedUntil             DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberships      OrganizationMember[]
  assignedClients  Client[]        @relation("ClientAssignee")
  assignedCases    CreditCase[]    @relation("CaseAssignee")
  assignedServiceCases ServiceCase[] @relation("ServiceCaseAssignee")
  assignedTasks    Task[]          @relation("TaskAssignee")
  createdTasks     Task[]          @relation("TaskCreator")
  uploadedDocs     Document[]      @relation("DocumentUploader")
  createdQuotes    Quote[]         @relation("QuoteCreator")
  createdPayments  Payment[]       @relation("PaymentCreator")
  createdPaymentPlans PaymentPlan[] @relation("PaymentPlanCreator")
  activities       ActivityLog[]   @relation("ActivityActor")
  auditLogs        AuditLog[]      @relation("AuditActor")
  notifications    Notification[]
  intakeLinks      IntakeLink[]    @relation("IntakeLinkCreator")
  aiChats          AiChat[]
  createdMails     MailMessage[] @relation("MailCreator")
  reportComparisons ReportComparison[] @relation("ComparisonCreator")
  progressReports   ClientProgressReport[] @relation("ProgressReportCreator")
  ownedOpportunities Opportunity[] @relation("OpportunityOwner")
  portalInvites      ClientPortalAccess[] @relation("PortalInviter")
  contractsCreated   ClientContract[]     @relation("ContractCreator")
  notesAuthored      Note[]               @relation("NoteAuthor")
  serviceCaseStageChanges ServiceCaseStageHistory[] @relation("StageHistoryActor")
}

model Organization {
  id        String   @id @default(cuid())
  name      String   @default("J&H Multiservices LLC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings           OrganizationSettings?
  members            OrganizationMember[]
  stages             WorkflowStage[]
  clients            Client[]
  sensitiveProfiles  ClientSensitiveProfile[]
  cases              CreditCase[]
  serviceCases       ServiceCase[]
  notes              Note[]
  rounds             CreditRound[]
  documents          Document[]
  tasks              Task[]
  activities         ActivityLog[]
  services           Service[]
  packages           ServicePackage[]
  quotes             Quote[]
  quoteEvents        QuoteEvent[]
  payments           Payment[]
  receipts           Receipt[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  aiChats            AiChat[]
  intakeLinks        IntakeLink[]
  intakeSubmissions  IntakeSubmission[]
  consents           ConsentRecord[]
  externalReferences ExternalReference[]
  whatsappRecipients WhatsappRecipient[]
  emailRecipients    EmailNotificationRecipient[]
  mailMessages       MailMessage[]
  creditReports      CreditReport[]
  creditItems        CreditItem[]
  disputeItems       DisputeItem[]
  reportComparisons  ReportComparison[]
  letterTemplates    DisputeLetterTemplate[]
  disputeLetters     DisputeLetter[]
  progressReports    ClientProgressReport[]
  creditProcessors   CreditProcessor[]
  processorAccounts  ClientProcessorAccount[]
  opportunities      Opportunity[]
  paymentPlans       PaymentPlan[]
  consultations      Consultation[]
  portalAccesses     ClientPortalAccess[]
  contractTemplates  ContractTemplate[]
  clientContracts    ClientContract[]
  metaLeadEvents     MetaLeadEvent[]
  homeBuyerCases     HomeBuyerCase[]
  fundingCases       FundingCase[]
  fundingApplications FundingApplication[]
  personalLoanCases  PersonalLoanCase[]
  projectCases       ProjectCase[]
  testimonials     Testimonial[]
}

model OrganizationSettings {
  id             String   @id @default(cuid())
  organizationId String   @unique
  legalName      String   @default("J&H Multiservices LLC")
  logoUrl        String?
  phone          String?
  email          String?
  website        String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  postalCode     String?
  country        String   @default("US")
  timezone       String   @default("America/Chicago")
  currency       String   @default("USD")
  defaultTaxRate Decimal  @default(0) @db.Decimal(5, 2)
  quotePrefix    String   @default("Q")
  receiptPrefix  String   @default("REC")
  clientPrefix   String   @default("CL")
  casePrefix     String   @default("CASE")
  quoteCounter   Int      @default(0)
  receiptCounter Int      @default(0)
  clientCounter  Int      @default(0)
  caseCounter    Int      @default(0)
  defaultTerms   String?  @db.Text
  callmebotEnabled Boolean @default(false)
  smtpHost                 String?
  smtpPort                 Int?
  smtpUser                 String?
  smtpPasswordEncrypted    String?  @db.Text
  smtpFrom                 String?
  smtpSecure               Boolean  @default(true)
  smtpTestTo               String?
  digestEnabled            Boolean  @default(true)
  digestHour               Int      @default(8)
  notifyEmailTask          Boolean  @default(true)
  notifyWhatsappTask       Boolean  @default(true)
  notifyEmailCase          Boolean  @default(true)
  notifyWhatsappCase       Boolean  @default(true)
  notifyEmailPayment       Boolean  @default(true)
  notifyWhatsappPayment    Boolean  @default(true)
  notifyEmailDigest        Boolean  @default(true)
  notifyWhatsappDigest     Boolean  @default(true)
  notifyEmailMail          Boolean  @default(true)
  notifyWhatsappMail       Boolean  @default(true)
  notifyEmailContact       Boolean  @default(true)
  notifyWhatsappContact    Boolean  @default(true)
  notifyEmailIntake        Boolean  @default(true)
  notifyWhatsappIntake     Boolean  @default(true)
  emailClientPaymentDue    Boolean  @default(false)
  emailClientDocsPending   Boolean  @default(false)
  emailClientQuoteSent     Boolean  @default(false)
  emailClientQuoteExpiring Boolean  @default(false)
  emailClientCaseReview    Boolean  @default(false)
  emailClientRoundReview   Boolean  @default(false)
  /** Días tras soft-delete antes de hard-delete S3 (null = no auto-purge). */
  documentSoftDeleteRetentionDays Int?
  /** Retención máxima desde createdAt (null = sin límite). */
  documentMaxRetentionDays        Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model WhatsappRecipient {
  id              String   @id @default(cuid())
  organizationId  String
  label           String
  phone           String
  apiKeyEncrypted String   @db.Text
  enabled         Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, phone])
  @@index([organizationId, enabled])
}

/** Destinatarios de correo de avisos (p. ej. intake); no tienen que ser usuarios del CRM. */
model EmailNotificationRecipient {
  id             String   @id @default(cuid())
  organizationId String
  label          String
  email          String
  enabled        Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([organizationId, enabled])
}

model OrganizationMember {
  id             String   @id @default(cuid())
  role           Role     @default(STAFF)
  userId         String
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, role])
}

model WorkflowStage {
  id             String   @id @default(cuid())
  organizationId String
  /** Etapa pertenece a un Service (vertical). Obligatorio tras backfill ARC-004. */
  serviceId      String
  key            String
  name           String
  order          Int
  color          String   @default("#64748B")
  isTerminal     Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  cases        CreditCase[]
  serviceCases ServiceCase[]
  stageHistoryFrom ServiceCaseStageHistory[] @relation("StageHistoryFrom")
  stageHistoryTo   ServiceCaseStageHistory[] @relation("StageHistoryTo")

  @@unique([organizationId, serviceId, key])
  @@unique([organizationId, serviceId, order])
  @@index([organizationId, isActive])
  @@index([serviceId, isActive])
}

model Client {
  id             String       @id @default(cuid())
  organizationId String
  clientCode     String
  firstName      String
  lastName       String?
  email          String?
  phone          String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  postalCode     String?
  country        String       @default("US")
  source         String?
  leadChannel    LeadChannel?
  serviceRequested String?
  preferredContactMethod String?
  preferredContactTime String?
  attribution    Json?
  status         ClientStatus @default(LEAD)
  assignedToId   String?
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo      User?                   @relation("ClientAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  sensitive       ClientSensitiveProfile?
  cases           CreditCase[]
  serviceCases    ServiceCase[]
  notes           Note[]
  documents       Document[]
  tasks           Task[]
  activities      ActivityLog[]
  quotes          Quote[]
  payments        Payment[]
  receipts        Receipt[]
  intakeLinks     IntakeLink[]
  intakeSubmits   IntakeSubmission[]
  consents        ConsentRecord[]
  externalRefs    ExternalReference[]
  mailMessages    MailMessage[]
  creditReports   CreditReport[]
  creditItems     CreditItem[]
  processorAccounts ClientProcessorAccount[]
  opportunities   Opportunity[]
  paymentPlans    PaymentPlan[]
  consultations   Consultation[]
  portalAccess    ClientPortalAccess?
  contracts       ClientContract[]

  testimonials     Testimonial[]

  @@unique([organizationId, clientCode])
  @@index([organizationId, status])
  @@index([organizationId, assignedToId])
  @@index([organizationId, lastName, firstName])
  @@index([organizationId, createdAt])
  @@index([organizationId, email])
  @@index([organizationId, phone])
  @@index([organizationId, leadChannel])
}

model ClientSensitiveProfile {
  id                           String   @id @default(cuid())
  organizationId               String
  clientId                     String   @unique
  ssnLast4                     String?  @db.VarChar(4)
  ssnEncrypted                 String?  @db.Text
  dateOfBirthEncrypted         String?  @db.Text
  driversLicenseNumberEncrypted String? @db.Text
  sensitiveNotesEncrypted      String?  @db.Text
  encryptionVersion            Int      @default(1)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model CreditCase {
  id             String    @id @default(cuid())
  organizationId String
  clientId       String
  /** Wrap 1:1 ServiceCase (CREDIT_REPAIR). Obligatorio tras backfill ARC-003. */
  serviceCaseId  String    @unique
  caseCode       String
  stageId        String
  state          CaseState @default(OPEN)
  assignedToId   String?
  openedAt       DateTime  @default(now())
  nextReviewAt   DateTime?
  closedAt       DateTime?
  summary        String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  serviceCase  ServiceCase   @relation(fields: [serviceCaseId], references: [id], onDelete: Restrict)
  stage        WorkflowStage @relation(fields: [stageId], references: [id], onDelete: Restrict)
  assignedTo   User?         @relation("CaseAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  rounds        CreditRound[]
  documents     Document[]
  tasks         Task[]
  activities    ActivityLog[]
  quotes        Quote[]
  payments      Payment[]
  intakeLinks   IntakeLink[]
  intakeSubmits IntakeSubmission[]
  consents      ConsentRecord[]
  externalRefs  ExternalReference[]
  creditReports CreditReport[]
  creditItems   CreditItem[]
  reportComparisons ReportComparison[]
  progressReports ClientProgressReport[]
  processorAccounts ClientProcessorAccount[]
  opportunities Opportunity[]
  paymentPlans  PaymentPlan[]
  contracts     ClientContract[]

  @@unique([organizationId, caseCode])
  @@index([organizationId, stageId])
  @@index([organizationId, state, nextReviewAt])
  @@index([clientId, state])
  @@index([assignedToId, state])
}

/**
 * Expediente genérico de un servicio contratado.
 * CREDIT_REPAIR envuelve CreditCase 1:1 (ARCHITECTURE_V1).
 */
model ServiceCase {
  id             String            @id @default(cuid())
  organizationId String
  clientId       String
  serviceId      String
  caseNumber     String
  status         ServiceCaseStatus @default(OPEN)
  stageId        String
  assignedToId   String?
  startedAt      DateTime          @default(now())
  targetDate     DateTime?
  nextActionAt   DateTime?
  completedAt    DateTime?
  quotedAmount   Decimal?          @db.Decimal(12, 2)
  agreedAmount   Decimal?          @db.Decimal(12, 2)
  notes          String?           @db.Text
  archivedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service      Service       @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  stage        WorkflowStage @relation(fields: [stageId], references: [id], onDelete: Restrict)
  assignedTo   User?         @relation("ServiceCaseAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  creditCase   CreditCase?
  homeBuyerCase    HomeBuyerCase?
  fundingCase      FundingCase?
  personalLoanCase PersonalLoanCase?
  projectCase      ProjectCase?
  stageHistory ServiceCaseStageHistory[]
  notesList    Note[]
  documents    Document[]
  tasks        Task[]
  activities   ActivityLog[]
  quotes       Quote[]
  payments     Payment[]
  wonOpportunities Opportunity[] @relation("OpportunityWonServiceCase")

  testimonials     Testimonial[]

  @@unique([organizationId, caseNumber])
  @@index([clientId, status])
  @@index([organizationId, nextActionAt])
  @@index([stageId])
  @@index([organizationId, serviceId, status])
  @@index([assignedToId, status])
}

/** Historial de cambios de etapa (solo cambios nuevos; sin backfill). */
model ServiceCaseStageHistory {
  id            String   @id @default(cuid())
  serviceCaseId String
  fromStageId   String?
  toStageId     String
  changedById   String?
  changedAt     DateTime @default(now())

  serviceCase ServiceCase    @relation(fields: [serviceCaseId], references: [id], onDelete: Cascade)
  fromStage   WorkflowStage? @relation("StageHistoryFrom", fields: [fromStageId], references: [id], onDelete: SetNull)
  toStage     WorkflowStage  @relation("StageHistoryTo", fields: [toStageId], references: [id], onDelete: Restrict)
  changedBy   User?          @relation("StageHistoryActor", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([serviceCaseId, changedAt])
  @@index([toStageId])
}

/**
 * Fase 5 — Verticales secundarios: extensión 1:1 de ServiceCase.
 * Mismo patrón que CreditCase: se crean junto al ServiceCase de su vertical,
 * nunca sueltos. Sin estados propios: status/stage viven en ServiceCase.
 */

/** HB-001 — Compra de casa (Service.code = HOME_BUYER). */
model HomeBuyerCase {
  id                 String   @id @default(cuid())
  organizationId     String
  serviceCaseId      String   @unique
  budgetMin          Decimal? @db.Decimal(12, 2)
  budgetMax          Decimal? @db.Decimal(12, 2)
  targetArea         String?
  preApproved        Boolean  @default(false)
  preApprovalAmount  Decimal? @db.Decimal(12, 2)
  referralPartner    String?
  summary            String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  serviceCase  ServiceCase  @relation(fields: [serviceCaseId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

/** FD-001 — Financiamiento de negocio (Service.code = BUSINESS_CREDIT). */
model FundingCase {
  id                String   @id @default(cuid())
  organizationId    String
  serviceCaseId     String   @unique
  businessName      String?
  businessAgeMonths Int?
  requestedAmount   Decimal? @db.Decimal(12, 2)
  purpose           String?
  summary           String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  serviceCase  ServiceCase         @relation(fields: [serviceCaseId], references: [id], onDelete: Cascade)
  applications FundingApplication[]

  @@index([organizationId])
}

enum FundingApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  DENIED
  FUNDED
  WITHDRAWN
}

/** FD-002 — Aplicación concreta a un prestamista dentro de un FundingCase. */
model FundingApplication {
  id              String                    @id @default(cuid())
  organizationId  String
  fundingCaseId   String
  lenderName      String
  requestedAmount Decimal?                  @db.Decimal(12, 2)
  approvedAmount  Decimal?                  @db.Decimal(12, 2)
  status          FundingApplicationStatus  @default(DRAFT)
  submittedAt     DateTime?
  decisionAt      DateTime?
  notes           String?                   @db.Text
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fundingCase  FundingCase  @relation(fields: [fundingCaseId], references: [id], onDelete: Cascade)

  @@index([fundingCaseId, status])
  @@index([organizationId, status])
}

/** PL-001 — Préstamo personal (Service.code = PERSONAL_LOAN). */
model PersonalLoanCase {
  id              String   @id @default(cuid())
  organizationId  String
  serviceCaseId   String   @unique
  requestedAmount Decimal? @db.Decimal(12, 2)
  purpose         String?
  termMonths      Int?
  summary         String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  serviceCase  ServiceCase  @relation(fields: [serviceCaseId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

/** PJ-001 — Proyecto web/CRM (Service.code = WEB_DEVELOPMENT | CRM_DEVELOPMENT). */
model ProjectCase {
  id             String   @id @default(cuid())
  organizationId String
  serviceCaseId  String   @unique
  projectType    String?
  scopeSummary   String?  @db.Text
  deliveryUrl    String?
  repositoryUrl  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  serviceCase  ServiceCase  @relation(fields: [serviceCaseId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

/** Notas humanas nuevas (sin backfill desde ActivityLog.NOTE). */
model Note {
  id             String   @id @default(cuid())
  organizationId String
  clientId       String?
  serviceCaseId  String?
  authorUserId   String
  body           String   @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  serviceCase  ServiceCase? @relation(fields: [serviceCaseId], references: [id], onDelete: SetNull)
  author       User         @relation("NoteAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([clientId, createdAt])
  @@index([serviceCaseId, createdAt])
}

model CreditRound {
  id                    String      @id @default(cuid())
  organizationId        String
  caseId                String
  roundNumber           Int
  status                RoundStatus @default(DRAFT)
  startedAt             DateTime    @default(now())
  sentAt                DateTime?
  expectedReviewAt      DateTime?
  reviewedAt            DateTime?
  lettersCount          Int         @default(0)
  disputedItemsCount    Int         @default(0)
  notes                 String?     @db.Text
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  case         CreditCase   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  documents    Document[]
  tasks        Task[]
  activities   ActivityLog[]
  disputeItems DisputeItem[]
  disputeLetters DisputeLetter[]
  progressReports ClientProgressReport[]

  @@unique([caseId, roundNumber])
  @@index([organizationId, status, expectedReviewAt])
  @@index([caseId, status])
}

model Document {
  id             String              @id @default(cuid())
  organizationId String
  clientId       String
  caseId         String?
  serviceCaseId  String?
  roundId        String?
  paymentId      String?
  category       DocumentCategory
  sensitivity    DocumentSensitivity @default(CONFIDENTIAL)
  originalName   String
  displayName    String?
  mimeType       String
  sizeBytes      Int
  storageKey     String              @unique
  checksumSha256 String?
  uploadedById   String?
  deletedAt      DateTime?
  /** Fecha programada de hard-delete (S3 + metadata). */
  purgeAfter     DateTime?
  hardDeletedAt  DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  case          CreditCase?    @relation(fields: [caseId], references: [id], onDelete: SetNull)
  serviceCase   ServiceCase?   @relation(fields: [serviceCaseId], references: [id], onDelete: SetNull)
  round         CreditRound?   @relation(fields: [roundId], references: [id], onDelete: SetNull)
  payment       Payment?       @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  uploadedBy    User?          @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  creditReports CreditReport[]
  disputeLetters DisputeLetter[]
  clientContracts ClientContract[]

  @@index([organizationId, clientId, category])
  @@index([caseId, category])
  @@index([serviceCaseId, category])
  @@index([roundId, category])
  @@index([paymentId])
  @@index([organizationId, deletedAt])
  @@index([organizationId, purgeAfter])
  @@index([organizationId, hardDeletedAt])
}

model Task {
  id             String       @id @default(cuid())
  organizationId String
  clientId       String?
  caseId         String?
  serviceCaseId  String?
  roundId        String?
  title          String
  description    String?      @db.Text
  type           TaskType     @default(OTHER)
  priority       TaskPriority @default(NORMAL)
  status         TaskStatus   @default(PENDING)
  dueAt          DateTime?
  reminderAt     DateTime?
  completedAt    DateTime?
  assignedToId   String
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  case         CreditCase?  @relation(fields: [caseId], references: [id], onDelete: SetNull)
  serviceCase  ServiceCase? @relation(fields: [serviceCaseId], references: [id], onDelete: SetNull)
  round        CreditRound? @relation(fields: [roundId], references: [id], onDelete: SetNull)
  assignedTo   User         @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, status, dueAt])
  @@index([assignedToId, status, dueAt])
  @@index([clientId, status])
  @@index([caseId, status])
  @@index([serviceCaseId, status])
  @@index([roundId, status])
  @@index([organizationId, reminderAt])
}

model Service {
  id             String   @id @default(cuid())
  organizationId String
  /** Identificador estable de vertical (p.ej. CREDIT_REPAIR). Nullable: ítems de catálogo comercial sin vertical. */
  code           String?
  name           String
  description    String?  @db.Text
  defaultPrice   Decimal  @default(0) @db.Decimal(12, 2)
  currency       String   @default("USD")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  packageItems ServicePackageItem[]
  quoteItems   QuoteItem[]
  workflowStages WorkflowStage[]
  serviceCases ServiceCase[]

  @@unique([organizationId, name])
  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@index([organizationId, code])
}

model ServicePackage {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?  @db.Text
  defaultPrice   Decimal  @default(0) @db.Decimal(12, 2)
  currency       String   @default("USD")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        ServicePackageItem[]
  quoteItems   QuoteItem[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
}

model ServicePackageItem {
  id        String @id @default(cuid())
  packageId String
  serviceId String
  quantity  Int    @default(1)

  package ServicePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  service Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([packageId, serviceId])
  @@index([serviceId])
}

model Quote {
  id             String      @id @default(cuid())
  organizationId String
  clientId       String
  caseId         String?
  serviceCaseId  String?
  folioNumber    Int
  folio          String
  status         QuoteStatus @default(DRAFT)
  currency       String      @default("USD")
  issuedAt       DateTime    @default(now())
  validUntil     DateTime?
  subtotal       Decimal     @default(0) @db.Decimal(12, 2)
  discountTotal  Decimal     @default(0) @db.Decimal(12, 2)
  taxRate        Decimal     @default(0) @db.Decimal(5, 2)
  taxAmount      Decimal     @default(0) @db.Decimal(12, 2)
  total          Decimal     @default(0) @db.Decimal(12, 2)
  notes          String?     @db.Text
  terms          String?     @db.Text
  sentAt         DateTime?
  acceptedAt     DateTime?
  paidAt         DateTime?
  createdById    String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  case         CreditCase?  @relation(fields: [caseId], references: [id], onDelete: SetNull)
  serviceCase  ServiceCase? @relation(fields: [serviceCaseId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation("QuoteCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items        QuoteItem[]
  events       QuoteEvent[]
  payments     Payment[]
  paymentPlans PaymentPlan[]

  @@unique([organizationId, folio])
  @@index([organizationId, status, issuedAt])
  @@index([clientId, issuedAt])
  @@index([caseId, status])
  @@index([serviceCaseId, status])
}

model QuoteItem {
  id             String   @id @default(cuid())
  quoteId        String
  serviceId      String?
  packageId      String?
  description    String   @db.Text
  quantity       Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice      Decimal  @default(0) @db.Decimal(12, 2)
  discountAmount Decimal  @default(0) @db.Decimal(12, 2)
  total          Decimal  @default(0) @db.Decimal(12, 2)
  order          Int      @default(0)

  quote   Quote           @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  service Service?        @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  package ServicePackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  @@index([quoteId, order])
  @@index([serviceId])
  @@index([packageId])
}

model QuoteEvent {
  id             String         @id @default(cuid())
  organizationId String
  quoteId        String
  type           QuoteEventType
  description    String?        @db.Text
  metadata       Json?
  createdAt      DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quote        Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, createdAt])
  @@index([organizationId, createdAt])
}

model Payment {
  id             String        @id @default(cuid())
  organizationId String
  clientId       String
  caseId         String?
  serviceCaseId  String?
  quoteId        String?
  amount         Decimal       @db.Decimal(12, 2)
  currency       String        @default("USD")
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  reference      String?
  dueAt          DateTime?
  receivedAt     DateTime?
  notes          String?       @db.Text
  createdById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  case         CreditCase?  @relation(fields: [caseId], references: [id], onDelete: SetNull)
  serviceCase  ServiceCase? @relation(fields: [serviceCaseId], references: [id], onDelete: SetNull)
  quote        Quote?       @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation("PaymentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  documents    Document[]
  receipt      Receipt?
  installment  PaymentInstallment?
  consultation Consultation?

  @@index([organizationId, status, dueAt])
  @@index([clientId, receivedAt])
  @@index([quoteId, status])
  @@index([caseId, status])
  @@index([serviceCaseId, status])
}

model Receipt {
  id             String        @id @default(cuid())
  organizationId String
  paymentId      String        @unique
  clientId       String
  folioNumber    Int
  folio          String
  status         ReceiptStatus @default(ISSUED)
  amount         Decimal       @db.Decimal(12, 2)
  currency       String        @default("USD")
  paymentMethod  PaymentMethod
  issuedAt       DateTime      @default(now())
  voidedAt       DateTime?
  voidReason     String?       @db.Text
  notes          String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payment      Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([organizationId, folio])
  @@index([organizationId, status, issuedAt])
  @@index([clientId, issuedAt])
}

/** Plan de pagos a plazos (genera cuotas + Payment PENDING). */
model PaymentPlan {
  id                   String              @id @default(cuid())
  organizationId       String
  clientId             String
  caseId               String?
  quoteId              String?
  totalAmount          Decimal             @db.Decimal(12, 2)
  installmentAmount    Decimal             @db.Decimal(12, 2)
  frequency            PaymentPlanFrequency
  numberOfInstallments Int
  startDate            DateTime
  status               PaymentPlanStatus   @default(ACTIVE)
  currency             String              @default("USD")
  notes                String?             @db.Text
  createdById          String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  case         CreditCase?          @relation(fields: [caseId], references: [id], onDelete: SetNull)
  quote        Quote?               @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  createdBy    User?                @relation("PaymentPlanCreator", fields: [createdById], references: [id], onDelete: SetNull)
  installments PaymentInstallment[]

  @@index([organizationId, status, startDate])
  @@index([clientId, status])
  @@index([caseId, status])
  @@index([quoteId])
}

model PaymentInstallment {
  id             String                   @id @default(cuid())
  organizationId String
  planId         String
  sequence       Int
  amount         Decimal                  @db.Decimal(12, 2)
  dueAt          DateTime
  status         PaymentInstallmentStatus @default(PENDING)
  paymentId      String?                  @unique
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  plan    PaymentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  payment Payment?    @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([planId, sequence])
  @@index([organizationId, status, dueAt])
  @@index([planId, status])
}

/**
 * Solicitud de consulta ($1 u otro monto). Cobro desacoplado del formulario.
 * Sin procesador configurado permanece REQUESTED (nunca se finge PAID).
 */
model Consultation {
  id             String             @id @default(cuid())
  organizationId String
  clientId       String
  amount         Decimal            @default(1) @db.Decimal(12, 2)
  currency       String             @default("USD")
  status         ConsultationStatus @default(REQUESTED)
  paymentId      String?            @unique
  notes          String?            @db.Text
  scheduledAt    DateTime?
  requestedAt    DateTime           @default(now())
  completedAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  payment      Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, requestedAt])
  @@index([clientId, status])
}

/** Acceso al portal del cliente (separado del staff CRM). */
model ClientPortalAccess {
  id             String    @id @default(cuid())
  organizationId String
  clientId       String    @unique
  email          String
  passwordHash   String
  isActive       Boolean   @default(true)
  sessionVersion Int       @default(1)
  lastLoginAt    DateTime?
  invitedAt      DateTime  @default(now())
  invitedById    String?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("PortalInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, email])
  @@index([organizationId, isActive])
}

/** Plantilla de contrato de servicio (org). */
model ContractTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  version        String   @default("1.0")
  contentHtml    String   @db.LongText
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contracts    ClientContract[]

  @@index([organizationId, active])
  @@index([organizationId, name])
}

/** Contrato emitido a un cliente (snapshot + firma). */
model ClientContract {
  id                   String         @id @default(cuid())
  organizationId       String
  clientId             String
  caseId               String?
  templateId           String?
  title                String
  version              String
  contentSnapshot      String         @db.LongText
  status               ContractStatus @default(DRAFT)
  signerName           String?
  signerIp             String?
  userAgent            String?        @db.Text
  signatureData        String?        @db.LongText
  signedAt             DateTime?
  cancellationDeadline DateTime?
  documentId           String?
  createdById          String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  case         CreditCase?      @relation(fields: [caseId], references: [id], onDelete: SetNull)
  template     ContractTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  document     Document?        @relation(fields: [documentId], references: [id], onDelete: SetNull)
  createdBy    User?            @relation("ContractCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
  @@index([clientId, status])
  @@index([caseId, status])
  @@index([templateId])
  @@index([documentId])
}

model ActivityLog {
